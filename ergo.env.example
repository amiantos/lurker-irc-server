# Copy to ergo.env (gitignored). scripts/render.sh substitutes these into
# ergo/ircd.yaml.tmpl → data/ircd.yaml. Every value is required.

# The hosted fleet's VPC, so cells are exempt from the per-IP connection limit.
# provision.sh prints it; or: doctl vpcs get <id> --format IPRange --no-header
VPC_CIDR=10.0.0.0/16

# Oper password hashes. Make one with:  scripts/genpasswd.sh
OPER_BRAD_HASH='$2a$04$replace-me'
OPER_JAWSH_HASH='$2a$04$replace-me'
OPER_D3FC0N_HASH='$2a$04$replace-me'

# Resend API key used ONLY for registration/verification mail. Make a separate,
# sending-only key named "irc.lurker.chat" rather than reusing the fleet's.
RESEND_API_KEY=re_replace_me
